{
  "manifest_version": 3,
  "name": "CoordKey — 键盘坐标点击",
  "version": "1.0.0",
  "description": "把键盘快捷键绑定到页面坐标：按下单键或组合键即在指定位置触发鼠标点击，无需移动鼠标。支持顺序连点组、多套方案切换与坐标标记浮层，普通网页与 canvas 页面通用。",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "CoordKey：点击切换总开关",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared/protocol.js",
        "src/content/00-namespace.js",
        "src/content/core/hotkeys.js",
        "src/content/core/store.js",
        "src/content/core/clicker.js",
        "src/content/core/transfer.js",
        "src/content/ui/styles.js",
        "src/content/ui/hint.js",
        "src/content/ui/markers.js",
        "src/content/ui/recorder.js",
        "src/content/ui/panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
